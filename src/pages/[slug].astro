---
import { getCollection, render } from 'astro:content';
import Explainer from '../layouts/Explainer.astro';
import { components } from '../components/index.ts';

export async function getStaticPaths() {
  const entries = await getCollection('explainers');
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const words = (entry.body ?? '').replace(/<[^>]+>|[#*`>{}\[\]()|_-]/g, ' ').split(/\s+/).filter(Boolean).length;
const readingMinutes = Math.max(1, Math.round(words / 220));
---
<Explainer {...entry.data} readingMinutes={readingMinutes} headings={headings}>
  <Content components={components} />
</Explainer>
