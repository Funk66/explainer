---
// Wrap a normal markdown ordered list (1. 2. 3.) to render it as a vertical step sequence.
---
<div class="steps-list my-8"><slot /></div>
<style>
  .steps-list :global(> ol) { list-style: none; padding-left: 0; counter-reset: step; margin: 0; }
  .steps-list :global(> ol > li) { position: relative; counter-increment: step; padding-left: 3.25rem; padding-bottom: 1.25rem; margin: 0; }
  .steps-list :global(> ol > li::before) {
    content: counter(step); position: absolute; left: 0; top: 0.1rem; width: 2.1rem; height: 2.1rem;
    display: grid; place-items: center; border-radius: 9999px; font-weight: 650; font-size: 0.9rem;
    background: var(--color-primary); color: var(--color-primary-content);
  }
  .steps-list :global(> ol > li::after) {
    content: ''; position: absolute; left: 1.03rem; top: 2.5rem; bottom: 0.2rem; width: 2px; background: var(--color-base-300);
  }
  .steps-list :global(> ol > li:last-child::after) { display: none; }
  .steps-list :global(> ol > li > p:first-child) { margin-top: 0.25rem; }
</style>
