---
interface Stat { label: string; value: string | number; desc?: string }
interface Props { items: Stat[] }
const { items } = Astro.props;
if (!Array.isArray(items) || items.length === 0) throw new Error('<Stats> needs items={[{ label, value, desc? }, ...]}');
// Wraps instead of overflowing: 2 or 4 items → 2 columns, otherwise up to 3 per row.
const cols = items.length === 1 ? '' : items.length === 2 || items.length === 4 ? 'sm:grid-cols-2' : 'sm:grid-cols-3';
---
<div class:list={['not-prose my-8 grid gap-px overflow-hidden rounded-box border border-base-300 bg-base-300', cols]}>
  {items.map((s) => (
    <div class="stat-cell flex flex-col items-center justify-center px-5 py-5 text-center">
      <div class="text-sm text-base-content/60">{s.label}</div>
      <div class="mt-1 font-serif text-3xl sm:text-4xl font-semibold leading-tight text-primary text-balance">{s.value}</div>
      {s.desc && <div class="mt-1 text-xs text-base-content/55 text-balance">{s.desc}</div>}
    </div>
  ))}
</div>
<style>
  .stat-cell { background: color-mix(in oklab, var(--color-base-200) 60%, var(--color-base-100)); }
</style>
