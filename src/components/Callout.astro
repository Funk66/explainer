---
type Kind = 'note' | 'info' | 'tip' | 'warning' | 'danger' | 'key' | 'tldr' | 'example';
interface Props { type?: Kind; title?: string }
const KINDS: Record<Kind, { label: string; color: string; icon: string }> = {
  note:    { label: 'Note',          color: 'var(--color-neutral)',   icon: 'M12 20h9M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4Z' },
  info:    { label: 'Info',          color: 'var(--color-info)',      icon: 'M12 16v-4M12 8h.01M22 12a10 10 0 1 1-20 0 10 10 0 0 1 20 0Z' },
  tip:     { label: 'Tip',           color: 'var(--color-success)',   icon: 'M9 18h6M10 22h4M12 2a7 7 0 0 0-4 12.7V17h8v-2.3A7 7 0 0 0 12 2Z' },
  warning: { label: 'Watch out',     color: 'var(--color-warning)',   icon: 'M12 9v4M12 17h.01M10.3 3.9 1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0Z' },
  danger:  { label: 'Danger',        color: 'var(--color-error)',     icon: 'M12 8v4M12 16h.01M7.9 2h8.2L22 7.9v8.2L16.1 22H7.9L2 16.1V7.9Z' },
  key:     { label: 'Key idea',      color: 'var(--color-primary)',   icon: 'M15.5 7.5 19 4M21 2l-2 2M11.4 11.6a5.5 5.5 0 1 1-7.8 7.8 5.5 5.5 0 0 1 7.8-7.8Zm0 0L15.5 7.5l3 3L22 7l-3-3' },
  tldr:    { label: 'In short',      color: 'var(--color-secondary)', icon: 'M4 6h16M4 12h10M4 18h7' },
  example: { label: 'Example',       color: 'var(--color-accent)',    icon: 'M14.5 4h-5L7 7H4a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2h-3Z M12 17a4 4 0 1 0 0-8 4 4 0 0 0 0 8Z' },
};
const { type = 'note', title } = Astro.props;
if (!(type in KINDS)) throw new Error(`<Callout type="${type}"> is not valid. Use one of: ${Object.keys(KINDS).join(', ')}`);
const k = KINDS[type];
---
<aside class="callout my-7 rounded-box border-l-4 px-5 py-4" style={`--c:${k.color}`}>
  <div class="not-prose flex items-center gap-2 mb-1.5 text-[0.8rem] font-semibold uppercase tracking-wider" style="color: var(--c)">
    <svg class="size-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d={k.icon} /></svg>
    <span>{title ?? k.label}</span>
  </div>
  <div class="callout-body"><slot /></div>
</aside>
<style>
  .callout { border-color: var(--c); background: color-mix(in oklab, var(--c) 8%, var(--color-base-100)); }
  .callout-body { font-size: 0.98rem; line-height: 1.65; }
  .callout-body > :global(:first-child) { margin-top: 0; }
  .callout-body > :global(:last-child) { margin-bottom: 0; }
</style>
