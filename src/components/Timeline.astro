---
interface Event { date: string; title: string; text?: string }
interface Props { items: Event[] }
const { items } = Astro.props;
if (!Array.isArray(items) || items.length === 0) throw new Error('<Timeline> needs items={[{ date, title, text? }, ...]}');
---
<ul class="not-prose timeline timeline-vertical timeline-compact timeline-snap-icon my-8">
  {items.map((e, i) => (
    <li>
      {i > 0 && <hr class="bg-base-300" />}
      <div class="timeline-middle">
        <span class="block size-3 rounded-full bg-primary ring-4 ring-primary/20 mx-1"></span>
      </div>
      <div class="timeline-end mb-8 ml-2">
        <time class="font-mono text-xs font-semibold text-secondary">{e.date}</time>
        <div class="font-serif text-lg font-semibold leading-snug">{e.title}</div>
        {e.text && <p class="text-[0.95rem] text-base-content/75 leading-relaxed mt-1">{e.text}</p>}
      </div>
      {i < items.length - 1 && <hr class="bg-base-300" />}
    </li>
  ))}
</ul>
