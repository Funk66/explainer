{
  "name": "explainer",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=23.6"
  },
  "scripts": {
    "start": "node server/main.ts",
    "explain": "node agent/cli.ts",
    "build": "node scripts/build.ts",
    "check": "node scripts/check.ts",
    "rebuild": "node scripts/rebuild.ts",
    "build:app": "node scripts/build-app.ts",
    "dev": "astro dev",
    "test": "node scripts/build.ts fixtures/showcase && node scripts/check.ts fixtures/showcase",
    "typecheck": "tsc --ignoreConfig --noEmit --strict --module nodenext --moduleResolution nodenext --target es2024 --allowImportingTsExtensions --erasableSyntaxOnly --skipLibCheck --types node agent/*.ts agent/research/*.ts scripts/*.ts scripts/lib/*.ts server/*.ts",
    "postinstall": "playwright install chromium"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.10",
    "@astrojs/mdx": "^8.1.6",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@hono/node-server": "^2.1.11",
    "@mozilla/readability": "^0.6.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.5",
    "astro": "^7.4.13",
    "daisyui": "^5.8.2",
    "echarts": "^6.1.0",
    "esbuild": "^0.28.2",
    "hono": "^4.13.22",
    "katex": "^0.16.47",
    "linkedom": "^0.18.15",
    "mermaid": "^12.3.0",
    "openai": "^7.64.0",
    "playwright": "^1.65.1",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-mdx": "^3.1.1",
    "remark-parse": "^11.0.0",
    "tailwindcss": "^4.3.5",
    "undici": "^8.13.1",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.2.0",
    "unpdf": "^2.2.2",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.7",
    "typescript": "^7.0.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true
  }
}
